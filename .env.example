# Server-only URL for the Waiver Ops FastAPI service.
# Local development defaults to http://127.0.0.1:8000 when this is omitted.
WAIVER_API_BASE_URL=http://127.0.0.1:8000

# Keep development mode for the local FastAPI development identity. Switch to
# auth0 only after all Auth0 values below are configured.
WAIVER_WEB_AUTH_MODE=development
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate 32 random bytes as 64 hexadecimal characters.
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
