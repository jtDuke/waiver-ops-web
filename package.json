{
  "name": "waiver-ops-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stack": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stack.ps1",
    "prebuild": "node scripts/check-hosted-config.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:hosted-config": "node scripts/check-hosted-config.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.29.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  }
}
